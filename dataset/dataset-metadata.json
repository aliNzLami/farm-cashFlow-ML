{
  "title": "AgriCommodity Futures — Multi-Source ML Dataset",
  "id": "khimtagia/agricommodity-futures-multi-source-ml-dataset",
  "licenses": [{"name": "CC BY 4.0"}],
  "keywords": ["time-series","finance","agriculture","machine-learning","commodity","preprocessing","lstm","lightgbm"],
  "collaborators": [],
  "data": [
    {
      "description": "Daily ML-ready features for Coffee KC=F futures. 3,736 rows x 89 features.",
      "name": "integrated_coffee_daily.csv",
      "totalBytes": 4300000,
      "columns": [
        {"name": "Date",                    "description": "Trading date (YYYY-MM-DD)"},
        {"name": "Close",                   "description": "Adjusted closing price (USD cents/pound)"},
        {"name": "Open",                    "description": "Opening price"},
        {"name": "High",                    "description": "Daily high price"},
        {"name": "Low",                     "description": "Daily low price"},
        {"name": "Volume",                  "description": "Trading volume (contracts)"},
        {"name": "log_return",              "description": "Daily log return: ln(Close_t / Close_{t-1})"},
        {"name": "currency_adjusted_close", "description": "Close x USD/BRL rate — price from Brazilian producer perspective"},
        {"name": "RSI_14",                  "description": "Relative Strength Index, 14-period"},
        {"name": "BB_upper",                "description": "Bollinger Band upper (SMA20 + 2*sigma)"},
        {"name": "BB_lower",                "description": "Bollinger Band lower (SMA20 - 2*sigma)"},
        {"name": "BB_middle",               "description": "Bollinger Band middle (SMA20)"},
        {"name": "MACD",                    "description": "MACD line: EMA12 - EMA26"},
        {"name": "MACD_signal",             "description": "MACD signal line: EMA9 of MACD"},
        {"name": "MACD_hist",               "description": "MACD histogram: MACD - MACD_signal"},
        {"name": "SMA_20",                  "description": "Simple moving average 20 days"},
        {"name": "SMA_50",                  "description": "Simple moving average 50 days"},
        {"name": "momentum_1w",             "description": "1-week price momentum: Close/Close.shift(5) - 1"},
        {"name": "momentum_1m",             "description": "1-month price momentum: Close/Close.shift(21) - 1"},
        {"name": "volatility_20d",          "description": "Realized volatility annualized: std(log_return, 20) * sqrt(252)"},
        {"name": "rv_5d",                   "description": "5-day realized volatility annualized"},
        {"name": "rv_20d",                  "description": "20-day realized volatility annualized"},
        {"name": "rv_ratio",                "description": "Short/long vol regime: rv_5d / (rv_20d + eps)"},
        {"name": "hl_range_pct",            "description": "Intraday range: (High - Low) / Close"},
        {"name": "volume_ratio",            "description": "Volume relative to 20-day average"},
        {"name": "usd_Close",               "description": "USD/BRL exchange rate closing price"},
        {"name": "usd_log_return",          "description": "Daily log return of USD/BRL"},
        {"name": "usd_rv_5d",               "description": "5-day realized volatility of USD/BRL"},
        {"name": "usd_rv_20d",              "description": "20-day realized volatility of USD/BRL"},
        {"name": "inf_CPI_MoM_pct",         "description": "US CPI month-over-month % change (BLS, release-lag adjusted +1mo+12d)"},
        {"name": "inf_CPI_YoY_pct",         "description": "US CPI year-over-year % change"},
        {"name": "inflation_pressure",      "description": "usd_log_return_lag_1w*100 - inf_CPI_MoM_pct"},
        {"name": "vix_close",               "description": "CBOE VIX closing value (global risk sentiment)"},
        {"name": "vix_regime",              "description": "VIX regime: 0=low(<15), 1=medium(15-25), 2=high(>25)"},
        {"name": "temp_max_rolling_7d",     "description": "7-day mean of T_max averaged across 5 Brazil coffee regions (causal)"},
        {"name": "temp_max_rolling_14d",    "description": "14-day mean of T_max across coffee regions"},
        {"name": "precip_sum_rolling_7d",   "description": "7-day total precipitation across coffee regions"},
        {"name": "temp_max_cumsum_30d",     "description": "30-day cumulative T_max (heat accumulation proxy)"},
        {"name": "precip_cumsum_30d",       "description": "30-day cumulative precipitation"},
        {"name": "et0_cumsum_30d",          "description": "30-day cumulative evapotranspiration (FAO ET0)"},
        {"name": "dry_days_7d",             "description": "Count of days with zero precipitation in last 7 days"},
        {"name": "temp_bio_lag",            "description": "T_max shifted 34 weeks back (biological lag: flowering to harvest)"},
        {"name": "precip_bio_lag",          "description": "Precipitation shifted 34 weeks back (biological lag)"},
        {"name": "cal_sin_week",            "description": "Cyclical encoding of week-of-year: sin(2pi*week/52)"},
        {"name": "cal_cos_week",            "description": "Cyclical encoding of week-of-year: cos(2pi*week/52)"},
        {"name": "cal_sin_month",           "description": "Cyclical encoding of month: sin(2pi*month/12)"},
        {"name": "cal_cos_month",           "description": "Cyclical encoding of month: cos(2pi*month/12)"},
        {"name": "cal_is_flowering",        "description": "Binary flag: coffee flowering stage (synthetic, rule-based)"},
        {"name": "cal_is_harvest",          "description": "Binary flag: coffee harvest stage (synthetic, rule-based)"},
        {"name": "cal_duration",            "description": "Cumulative days in current crop stage"},
        {"name": "target_binary",           "description": "Label: 1 if return_future > 2.5% threshold, else 0 (base rate ~35%)"},
        {"name": "target_soft",             "description": "Soft label: sigmoid((return_future - theta) / tau)"},
        {"name": "target_reg",              "description": "Regression label: return_future clipped to [-0.30, +0.30]"},
        {"name": "target_multiclass",       "description": "3-class label: 0=Down, 1=Flat, 2=Up (threshold ±2.5%)"}
      ]
    },
    {
      "description": "Weekly aggregated features for Coffee KC=F. 724 rows x 82 features. W-MON anchor.",
      "name": "integrated_coffee_weekly.csv",
      "columns": []
    },
    {
      "description": "Daily ML-ready features for Corn ZC=F futures. 3,733 rows x 91 features.",
      "name": "integrated_corn_daily.csv",
      "columns": [
        {"name": "Date",               "description": "Trading date (YYYY-MM-DD)"},
        {"name": "Close",              "description": "Adjusted closing price (USD cents/bushel)"},
        {"name": "log_return",         "description": "Daily log return"},
        {"name": "RSI_14",             "description": "14-period Relative Strength Index"},
        {"name": "volatility_20d",     "description": "20-day realized volatility annualized"},
        {"name": "rv_ratio",           "description": "Short/long vol regime indicator"},
        {"name": "vix_close",          "description": "CBOE VIX (key feature for corn: gain=0.844 in LGBM)"},
        {"name": "inf_CPI_YoY_pct",    "description": "US CPI YoY — top feature in Stage 2b hurdle model (gain=0.300)"},
        {"name": "usd_rv_20d",         "description": "20-day USD/BRL realized vol — top feature Stage 2b (52 splits)"},
        {"name": "temp_bio_lag",       "description": "T_max shifted 9 weeks (corn: pollination to harvest lag)"},
        {"name": "precip_bio_lag",     "description": "Precipitation shifted 9 weeks"},
        {"name": "cal_cos_week",       "description": "Week cyclical encoding — top feature corn Stage 2b (gain=0.325)"},
        {"name": "cal_is_planting",    "description": "Binary: corn planting stage"},
        {"name": "cal_is_pollination", "description": "Binary: corn pollination stage (critical yield determinant)"},
        {"name": "cal_is_harvest",     "description": "Binary: corn harvest stage"},
        {"name": "target_binary",      "description": "Label: 1 if return_future > 2.5%, base rate ~30%"},
        {"name": "target_reg",         "description": "Regression label clipped to [-0.30, +0.30]"},
        {"name": "target_multiclass",  "description": "3-class: 0=Down, 1=Flat, 2=Up"}
      ]
    },
    {
      "description": "Weekly aggregated features for Corn ZC=F. 700 rows x 84 features. W-MON anchor.",
      "name": "integrated_corn_weekly.csv",
      "columns": []
    }
  ]
}
